    },
    {
      "verse_id": "5.35.2",
      "sarga": 35,
      "verse": 2,
      "sanskrit_iast": "hanūmān vākyam abravīt",
      "leonov_ru": "Хануман молвил слово.",
      "commentary": {"tilaka": "टीका"}
    },
    {
      "verse_id": "5.35.3",
      "sarga": 35,
      "verse": 3,
      "sanskrit_iast": "rāmasya guṇasampadam",
      "leonov_ru": "О совершенствах Рамы.",
      "commentary": {}
    },
    {
      "verse_id": "5.35.4",
      "sarga": 35,
      "verse": 4,
      "sanskrit_iast": "sītā śokaparāyaṇā",
      "leonov_ru": "Сита, предавшаяся горю.",
      "commentary": {}
    },
    {
      "verse_id": "5.36.1",
      "sarga": 36,
      "verse": 1,
      "sanskrit_iast": "anyat sargam",
      "leonov_ru": "Другая песнь — вне охвата сборки.",
      "commentary": {}
    }
