[
  {"comment_id": "up/syrkin/c1", "urn": "urn:cts:sanskritLit:brhadaranyaka:1.1.1", "shloka_addr": "Bṛh. Up. 1.1.1", "translator": "syrkin", "raw_text": "Голова жертвенного коня — это утренняя заря (uṣas). Сыркин отмечает символическое соответствие микрокосма и макрокосма. Ср. PU 149.", "has_iast": true, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K"},
  {"comment_id": "up/syrkin/c2", "urn": "urn:cts:sanskritLit:brhadaranyaka:2.3.6", "shloka_addr": "Bṛh. Up. 2.3.6", "translator": "syrkin", "raw_text": "«Не то, не то» (neti neti) — знаменитая апофатическая формула определения Брахмана. По толкованию Шанкары, означает отрицание всех преходящих форм. См. UM 432.", "has_iast": true, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c3", "urn": "urn:cts:sanskritLit:chandogya:1.1.1", "shloka_addr": "Chānd. Up. 1.1.1", "translator": "syrkin", "raw_text": "Удгитха (udgītha) — часть песнопения Сома-яджны, отождествляемая со слогом Ом. Сыркин анализирует ритуальную этимологию. Ср. CS 12.", "has_iast": true, "axis_1_topic": ["realia", "sanskrit_term"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P"},
  {"comment_id": "up/syrkin/c4", "urn": "urn:cts:sanskritLit:svetasvatara:1.1", "shloka_addr": "Śvet. Up. 1.1", "translator": "syrkin", "raw_text": "Вопрос о первопричине (brahmavādinaḥ). Сыркин отмечает переход от ведийского ритуализма к метафизическому поиску. См. БУ 231.", "has_iast": true, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c5", "urn": "urn:cts:sanskritLit:katha:1.1.1", "shloka_addr": "Kaṭha Up. 1.1.1", "translator": "syrkin", "raw_text": "Начикетас (nāciketa) — герой, спускающийся в царство Ямы. Имя этимологизируется как «не-знающий» или «ищущий знания».", "has_iast": true, "axis_1_topic": ["myth", "sanskrit_term"], "axis_2_kazansky": "A", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P"},
  {"comment_id": "up/syrkin/c6", "urn": "urn:cts:sanskritLit:mundaka:1.1.3", "shloka_addr": "Muṇḍ. Up. 1.1.3", "translator": "syrkin", "raw_text": "«Зная что, можно узнать всё это?» Основной вопрос упанишад об универсальном знании (vidyā). См. VN 45.", "has_iast": true, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c7", "urn": "urn:cts:sanskritLit:isa:1", "shloka_addr": "Īśā Up. 1", "translator": "syrkin", "raw_text": "«Всё это окутано Господом» (īśāvāsyam). Сыркин обсуждает теистический аспект этой упанишады. Ср. PU 567.", "has_iast": true, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c8", "urn": "urn:cts:sanskritLit:kena:1.1", "shloka_addr": "Kena Up. 1.1", "translator": "syrkin", "raw_text": "«Кем направляемый летит разум?» Сыркин отмечает психологический интроспекционизм текста. См. UM 112.", "has_iast": false, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c9", "urn": "urn:cts:sanskritLit:prasna:1.1", "shloka_addr": "Praśna Up. 1.1", "translator": "syrkin", "raw_text": "Шесть вопрошателей. Сыркин видит в этом структуру философского симпозиума.", "has_iast": false, "axis_1_topic": ["context"], "axis_2_kazansky": "V", "axis_3_lakshana": [], "axis_4_paribok": "P"},
  {"comment_id": "up/syrkin/c10", "urn": "urn:cts:sanskritLit:mandukya:1", "shloka_addr": "Māṇḍ. Up. 1", "translator": "syrkin", "raw_text": "Слог Ом как символ четырех состояний сознания (jāgrat, svapna, suṣupti, turīya). См. БУ 402.", "has_iast": true, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "K"},
  {"comment_id": "up/syrkin/c11", "urn": "urn:cts:sanskritLit:brhadaranyaka:3.1.1", "shloka_addr": "Bṛh. Up. 3.1.1", "translator": "syrkin", "raw_text": "Яджнявалкья (yājñavalkya) — великий мудрец, победитель в философском споре при дворе Джанаки.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P"},
  {"comment_id": "up/syrkin/c12", "urn": "urn:cts:sanskritLit:chandogya:6.8.7", "shloka_addr": "Chānd. Up. 6.8.7", "translator": "syrkin", "raw_text": "«То ты еси» (tat tvam asi) — великое речение (mahāvākya) о тождестве индивидуального и мирового духа. См. PU 458.", "has_iast": true, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c13", "urn": "urn:cts:sanskritLit:kaivalya:1", "shloka_addr": "Kaivalya Up. 1", "translator": "syrkin", "raw_text": "Понятие «Кайвалья» — абсолютная обособленность, освобождение. Сыркин отмечает йогический характер текста.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c14", "urn": "urn:cts:sanskritLit:aitareya:1.1", "shloka_addr": "Aitareya Up. 1.1", "translator": "syrkin", "raw_text": "Сотворение миров из вод. Сыркин сопоставляет с космогонией Ригведы (X.129).", "has_iast": false, "axis_1_topic": ["myth", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "up/syrkin/c15", "urn": "urn:cts:sanskritLit:taittiriya:2.1", "shloka_addr": "Taitt. Up. 2.1", "translator": "syrkin", "raw_text": "Учение о пяти оболочках (kośa) человека. Сыркин детально разбирает каждый уровень (anna, prāṇa, manas, vijñāna, ānanda).", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K"},
  {"comment_id": "up/syrkin/c16", "urn": "urn:cts:sanskritLit:brhadaranyaka:4.4.5", "shloka_addr": "Bṛh. Up. 4.4.5", "translator": "syrkin", "raw_text": "Закон кармы: «Каково деяние, таков и результат». Сыркин прослеживает этическую детерминированность упанишад. См. PU 270.", "has_iast": true, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "K"},
  {"comment_id": "up/syrkin/c17", "urn": "urn:cts:sanskritLit:chandogya:5.10.1", "shloka_addr": "Chānd. Up. 5.10.1", "translator": "syrkin", "raw_text": "Путь богов (devayāna) и путь отцов (pitṛyāna). Сыркин поясняет эсхатологические представления о посмертии. Ср. UM 156.", "has_iast": true, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "K"},
  {"comment_id": "up/syrkin/c18", "urn": "urn:cts:sanskritLit:svetasvatara:4.5", "shloka_addr": "Śvet. Up. 4.5", "translator": "syrkin", "raw_text": "Метафора двух птиц на одном дереве. Один вкушает плод, другой лишь созерцает. Сыркин отмечает символику дживы и атмана.", "has_iast": false, "axis_1_topic": ["philosophy", "poetics"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c19", "urn": "urn:cts:sanskritLit:brhadaranyaka:1.3.28", "shloka_addr": "Bṛh. Up. 1.3.28", "translator": "syrkin", "raw_text": "Молитва: «Веди меня от небытия к бытию» (asato mā sad gamaya). Сыркин анализирует онтологические оппозиции.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c20", "urn": "urn:cts:sanskritLit:chandogya:3.14.1", "shloka_addr": "Chānd. Up. 3.14.1", "translator": "syrkin", "raw_text": "«Шандилья-видья». Весь мир есть Брахман (sarvaṃ khalvidaṃ brahma). Сыркин отмечает монистический пафос текста. См. PU 391.", "has_iast": true, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c21", "urn": "urn:cts:sanskritLit:brhadaranyaka:1.4.10", "shloka_addr": "Bṛh. Up. 1.4.10", "translator": "syrkin", "raw_text": "«Я есмь Брахман» (ahaṃ brahmāsmi). Одно из четырех великих речений. Сыркин обсуждает самосознание абсолюта.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c22", "urn": "urn:cts:sanskritLit:katha:1.3.3", "shloka_addr": "Kaṭha Up. 1.3.3", "translator": "syrkin", "raw_text": "Метафора колесницы: Атман — хозяин, тело — колесница, разум — возница. Сыркин сопоставляет с платоновскими аллегориями. Ср. UM 234.", "has_iast": false, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c23", "urn": "urn:cts:sanskritLit:chandogya:7.1.1", "shloka_addr": "Chānd. Up. 7.1.1", "translator": "syrkin", "raw_text": "Нарада просит Санаткумару научить его. Перечисление наук того времени. Сыркин дает историко-культурный комментарий.", "has_iast": false, "axis_1_topic": ["realia", "context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P"},
  {"comment_id": "up/syrkin/c24", "urn": "urn:cts:sanskritLit:mundaka:1.1.4", "shloka_addr": "Muṇḍ. Up. 1.1.4", "translator": "syrkin", "raw_text": "Различение высшего (parā) и низшего (aparā) знания. Сыркин отмечает гносеологический дуализм упанишад. См. PU 670.", "has_iast": true, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "K"},
  {"comment_id": "up/syrkin/c25", "urn": "urn:cts:sanskritLit:maitri:1.1", "shloka_addr": "Maitrī Up. 1.1", "translator": "syrkin", "raw_text": "Царь Брихадратха осознает тщету жизни. Сыркин отмечает пессимистический тон поздних упанишад. См. VN 89.", "has_iast": false, "axis_1_topic": ["philosophy", "context"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "up/syrkin/c26", "urn": "urn:cts:sanskritLit:brhadaranyaka:5.2.3", "shloka_addr": "Bṛh. Up. 5.2.3", "translator": "syrkin", "raw_text": "Три наставления: «Дамята» (обуздайте себя), «Датта» (давайте), «Даядхвам» (сострадайте). Сыркин отмечает этический минимум упанишад.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "K"},
  {"comment_id": "up/syrkin/c27", "urn": "urn:cts:sanskritLit:chandogya:8.1.1", "shloka_addr": "Chānd. Up. 8.1.1", "translator": "syrkin", "raw_text": "«Дахара-видья» — учение о малом пространстве в сердце, тождественном космосу. Сыркин анализирует концепцию сердца.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c28", "urn": "urn:cts:sanskritLit:svetasvatara:6.1", "shloka_addr": "Śvet. Up. 6.1", "translator": "syrkin", "raw_text": "Прославление Рудры-Шивы как высшего бога. Сыркин отмечает рождение теистического монизма. См. PU 745.", "has_iast": true, "axis_1_topic": ["myth", "philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c29", "urn": "urn:cts:sanskritLit:kausitaki:1.1", "shloka_addr": "Kauṣ. Up. 1.1", "translator": "syrkin", "raw_text": "Вопрос о пути к Луне. Сыркин обсуждает древние космологические представления о «небесном мире».", "has_iast": false, "axis_1_topic": ["myth", "geography"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "up/syrkin/c30", "urn": "urn:cts:sanskritLit:brhadaranyaka:6.1.1", "shloka_addr": "Bṛh. Up. 6.1.1", "translator": "syrkin", "raw_text": "Спор чувств о первенстве. Сыркин отмечает важность праны (дыхания) как жизненного начала.", "has_iast": true, "axis_1_topic": ["philosophy", "myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "up/syrkin/c31", "urn": "urn:cts:sanskritLit:chandogya:4.1.1", "shloka_addr": "Chānd. Up. 4.1.1", "translator": "syrkin", "raw_text": "История Райквы с телесницей. Сыркин отмечает демократизм передачи знания в упанишадах.", "has_iast": false, "axis_1_topic": ["myth", "context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "up/syrkin/c32", "urn": "urn:cts:sanskritLit:katha:2.1.1", "shloka_addr": "Kaṭha Up. 2.1.1", "translator": "syrkin", "raw_text": "«Самосущий пробил отверстия [чувств] наружу». Сыркин поясняет теорию восприятия.", "has_iast": false, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c33", "urn": "urn:cts:sanskritLit:brhadaranyaka:2.4.1", "shloka_addr": "Bṛh. Up. 2.4.1", "translator": "syrkin", "raw_text": "Диалог Яджнявалкьи и Майтрейи о любви и Атмане. Сыркин отмечает вершину философской лирики. См. PU 197.", "has_iast": true, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c34", "urn": "urn:cts:sanskritLit:chandogya:5.1.1", "shloka_addr": "Chānd. Up. 5.1.1", "translator": "syrkin", "raw_text": "Учение о пяти огнях (паньчагни-видья). Сыркин поясняет метафизику перерождения.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K"},
  {"comment_id": "up/syrkin/c35", "urn": "urn:cts:sanskritLit:svetasvatara:2.8", "shloka_addr": "Śvet. Up. 2.8", "translator": "syrkin", "raw_text": "Наставления по практике йоги. Сыркин отмечает раннее появление технических терминов. См. UM 401.", "has_iast": true, "axis_1_topic": ["realia", "philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P"},
  {"comment_id": "up/syrkin/c36", "urn": "urn:cts:sanskritLit:taittiriya:1.1", "shloka_addr": "Taitt. Up. 1.1", "translator": "syrkin", "raw_text": "Призыв к ученику: «Говори истину, соблюдай дхарму». Сыркин анализирует педагогический идеал. Ср. БУ 145.", "has_iast": true, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "K"},
  {"comment_id": "up/syrkin/c37", "urn": "urn:cts:sanskritLit:brhadaranyaka:3.7.1", "shloka_addr": "Bṛh. Up. 3.7.1", "translator": "syrkin", "raw_text": "Учение о «внутреннем правителе» (antaryāmin). Сыркин поясняет вездесущность Атмана.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c38", "urn": "urn:cts:sanskritLit:chandogya:6.1.1", "shloka_addr": "Chānd. Up. 6.1.1", "translator": "syrkin", "raw_text": "История Шветакету. Глина и изделия из нее как метафора единства причины. Сыркин обсуждает онтологию субстанции. См. PU 446.", "has_iast": false, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c39", "urn": "urn:cts:sanskritLit:maitri:6.1", "shloka_addr": "Maitrī Up. 6.1", "translator": "syrkin", "raw_text": "Солнце как внешняя форма Атмана. Сыркин отмечает солярный символизм текста. См. VN 112.", "has_iast": false, "axis_1_topic": ["myth", "philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "up/syrkin/c40", "urn": "urn:cts:sanskritLit:brhadaranyaka:4.3.1", "shloka_addr": "Bṛh. Up. 4.3.1", "translator": "syrkin", "raw_text": "О свете человека. Когда нет солнца и луны, свет — это Атман. Сыркин анализирует метафизику света.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c41", "urn": "urn:cts:sanskritLit:chandogya:2.1.1", "shloka_addr": "Chānd. Up. 2.1.1", "translator": "syrkin", "raw_text": "Почитание Самана как благого. Сыркин поясняет музыкально-ритуальные соответствия. Ср. CS 45.", "has_iast": true, "axis_1_topic": ["realia", "sanskrit_term"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P"},
  {"comment_id": "up/syrkin/c42", "urn": "urn:cts:sanskritLit:katha:2.3.1", "shloka_addr": "Kaṭha Up. 2.3.1", "translator": "syrkin", "raw_text": "Мировое древо корнями вверх. Сыркин сопоставляет с аналогичными образами в Бхагавадгите (XV.1).", "has_iast": false, "axis_1_topic": ["philosophy", "poetics"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c43", "urn": "urn:cts:sanskritLit:brhadaranyaka:1.5.1", "shloka_addr": "Bṛh. Up. 1.5.1", "translator": "syrkin", "raw_text": "Семь видов пищи, созданных Отцом. Сыркин анализирует пищевой код в упанишадах.", "has_iast": false, "axis_1_topic": ["realia", "myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P"},
  {"comment_id": "up/syrkin/c44", "urn": "urn:cts:sanskritLit:chandogya:4.10.1", "shloka_addr": "Chānd. Up. 4.10.1", "translator": "syrkin", "raw_text": "История Упакошалы. Огонь учит его Брахману. Сыркин отмечает роль агни-хотры в передаче знания.", "has_iast": false, "axis_1_topic": ["myth", "realia"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "up/syrkin/c45", "urn": "urn:cts:sanskritLit:taittiriya:3.1", "shloka_addr": "Taitt. Up. 3.1", "translator": "syrkin", "raw_text": "Бхригу просит отца Варуну научить его Брахману. Сыркин отмечает важность аскезы (тапаса).", "has_iast": true, "axis_1_topic": ["myth", "philosophy"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "up/syrkin/c46", "urn": "urn:cts:sanskritLit:brhadaranyaka:5.1.1", "shloka_addr": "Bṛh. Up. 5.1.1", "translator": "syrkin", "raw_text": "«То — полнота, это — полнота». Сыркин поясняет математическую и метафизическую логику бесконечности. См. PU 289.", "has_iast": false, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c47", "urn": "urn:cts:sanskritLit:chandogya:5.11.1", "shloka_addr": "Chānd. Up. 5.11.1", "translator": "syrkin", "raw_text": "Пять брахманов и Вайшванара-Атман. Сыркин обсуждает концепцию «всеобщего человека».", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "K"},
  {"comment_id": "up/syrkin/c48", "urn": "urn:cts:sanskritLit:aitareya:3.1", "shloka_addr": "Aitareya Up. 3.1", "translator": "syrkin", "raw_text": "Отождествление Атмана с сознанием (праджняна). Сыркин отмечает интеллектуализм текста. См. БУ 121.", "has_iast": true, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c49", "urn": "urn:cts:sanskritLit:brhadaranyaka:4.5.15", "shloka_addr": "Bṛh. Up. 4.5.15", "translator": "syrkin", "raw_text": "«Где всё стало для него Атманом, там кого и через что он будет видеть?» Сыркин отмечает предел субъективизма.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "up/syrkin/c50", "urn": "urn:cts:sanskritLit:isa:18", "shloka_addr": "Īśā Up. 18", "translator": "syrkin", "raw_text": "Финальная молитва к Агни. Сыркин отмечает синтез ведийского гимна и упанишадской метафизики.", "has_iast": false, "axis_1_topic": ["myth", "philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"}
]
