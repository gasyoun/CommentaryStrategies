[
  {"comment_id": "mbh/vassilkov/c1", "urn": "urn:cts:sanskritLit:mahabharata:3.8.10", "shloka_addr": "MBh. Vana 3.8.10", "translator": "vassilkov", "raw_text": "«…выступили через городские ворота Вардхамана...» Знак Вардхамана («возрастающий», «процветающий») — графический символ, эмблема благополучия.", "has_iast": false, "axis_1_topic": ["realia"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c2", "urn": "urn:cts:sanskritLit:mahabharata:3.1.1", "shloka_addr": "MBh. Vana 3.1.1", "translator": "vassilkov", "raw_text": "«…самому Индре равные пламенностью духа…» Герои уподобляются богам-демоноборцам: богу грозы Индре, его помощнику Вишну. Пламенность духа (tejas) — магическая энергия кшатрия.", "has_iast": true, "axis_1_topic": ["myth", "philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2", "L5"], "axis_4_paribok": "K"},
  {"comment_id": "mbh/vassilkov/c3", "urn": "urn:cts:sanskritLit:mahabharata:8.1.1", "shloka_addr": "MBh. Karṇa 8.1.1", "translator": "vassilkov", "raw_text": "Карна-парва описывает кульминацию вражды между Карной и Арджуной. Карна здесь выступает как трагический герой, чья гибель предопределена.", "has_iast": false, "axis_1_topic": ["context"], "axis_2_kazansky": "V", "axis_3_lakshana": [], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c4", "urn": "urn:cts:sanskritLit:mahabharata:10.1.1", "shloka_addr": "MBh. Sauptika 10.1.1", "translator": "vassilkov", "raw_text": "Ночное нападение Ашваттхамана на лагерь Пандавов нарушает все правила кшатрийской дхармы. Это событие знаменует окончательный крах рыцарской этики.", "has_iast": false, "axis_1_topic": ["context", "philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "mbh/vassilkov/c5", "urn": "urn:cts:sanskritLit:mahabharata:11.1.1", "shloka_addr": "MBh. Strī 11.1.1", "translator": "vassilkov", "raw_text": "Плач женщин на поле битвы (вира-лапа) — традиционный фольклорный мотив, имеющий глубокие этнографические корни в погребальных обрядах.", "has_iast": false, "axis_1_topic": ["realia", "myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c6", "urn": "urn:cts:sanskritLit:mahabharata:12.174.1", "shloka_addr": "MBh. Mokṣa 12.174.1", "translator": "vassilkov", "raw_text": "Мокшадхарма содержит ядро философских учений Махабхараты. Понятие «освобождения» (мокша) здесь трактуется в духе ранней санкхьи и йоги.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "D"},
  {"comment_id": "mbh/vassilkov/c7", "urn": "urn:cts:sanskritLit:mahabharata:14.1.1", "shloka_addr": "MBh. Aśvamedhika 14.1.1", "translator": "vassilkov", "raw_text": "Жертвоприношение коня (ашвамедха) призвано очистить Юдхиштхиру от греха убийства родичей. Ритуал описан с большой этнографической точностью.", "has_iast": true, "axis_1_topic": ["realia"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c8", "urn": "urn:cts:sanskritLit:mahabharata:15.1.1", "shloka_addr": "MBh. Āśramavāsika 15.1.1", "translator": "vassilkov", "raw_text": "Уход престарелых царей в лес (ванапрастха) — третья стадия жизни (ашрама). Отражает древний индийский идеал отречения.", "has_iast": true, "axis_1_topic": ["realia", "philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K"},
  {"comment_id": "mbh/vassilkov/c9", "urn": "urn:cts:sanskritLit:mahabharata:16.1.1", "shloka_addr": "MBh. Mausala 16.1.1", "translator": "vassilkov", "raw_text": "Гибель рода Ядавов от ударов палицами — эсхатологический сюжет, знаменующий начало Кали-юги. Ср. с гибелью героев в германском эпосе.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c10", "urn": "urn:cts:sanskritLit:mahabharata:17.1.1", "shloka_addr": "MBh. Mahāprasthānika 17.1.1", "translator": "vassilkov", "raw_text": "Великое странствие Пандавов к Гималаям. Сопровождающая их собака — воплощение бога Дхармы, испытывающего Юдхиштхиру.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c11", "urn": "urn:cts:sanskritLit:mahabharata:18.1.1", "shloka_addr": "MBh. Svargārohaṇa 18.1.1", "translator": "vassilkov", "raw_text": "Восхождение на небеса и видение ада. Финальное испытание героя, где иллюзия (майя) проверяет его верность дхарме.", "has_iast": true, "axis_1_topic": ["myth", "philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "K"},
  {"comment_id": "mbh/vassilkov/c12", "urn": "urn:cts:sanskritLit:mahabharata:3.2.5", "shloka_addr": "MBh. Vana 3.2.5", "translator": "vassilkov", "raw_text": "Обряд «тарпана» (возлияние воды предкам). Васильков отмечает связь с верованиями о «пути отцов» (питрияна).", "has_iast": true, "axis_1_topic": ["realia"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c13", "urn": "urn:cts:sanskritLit:mahabharata:3.12.10", "shloka_addr": "MBh. Vana 3.12.10", "translator": "vassilkov", "raw_text": "Кришна как воплощение Вишну. Васильков указывает на процесс героизации племенного вождя и его превращение в аватару.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "mbh/vassilkov/c14", "urn": "urn:cts:sanskritLit:mahabharata:3.45.2", "shloka_addr": "MBh. Vana 3.45.2", "translator": "vassilkov", "raw_text": "Оружие «пашупата», дарованное Шивой Арджуне. Васильков анализирует шаманские корни сюжета обретения магического оружия.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c15", "urn": "urn:cts:sanskritLit:mahabharata:8.15.3", "shloka_addr": "MBh. Karṇa 8.15.3", "translator": "vassilkov", "raw_text": "Сравнение битвы с жертвоприношением. Поле боя как жертвенный алтарь — классическая метафора индийского эпоса.", "has_iast": false, "axis_1_topic": ["philosophy", "context"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "mbh/vassilkov/c16", "urn": "urn:cts:sanskritLit:mahabharata:11.15.5", "shloka_addr": "MBh. Strī 11.15.5", "translator": "vassilkov", "raw_text": "Проклятие Гандхари, наложенное на Кришну. Васильков отмечает юридическую силу проклятия в эпическом праве.", "has_iast": false, "axis_1_topic": ["realia", "myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c17", "urn": "urn:cts:sanskritLit:mahabharata:12.180.10", "shloka_addr": "MBh. Mokṣa 12.180.10", "translator": "vassilkov", "raw_text": "Учение о трех гунах (саттва, раджас, тамас). Васильков прослеживает развитие этих категорий от ведийских текстов.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K"},
  {"comment_id": "mbh/vassilkov/c18", "urn": "urn:cts:sanskritLit:mahabharata:14.20.1", "shloka_addr": "MBh. Aśvamedhika 14.20.1", "translator": "vassilkov", "raw_text": "Ану-гита («последующая гита»). Повторение наставлений Кришны Арджуне. Васильков считает этот текст поздней вставкой.", "has_iast": false, "axis_1_topic": ["textology"], "axis_2_kazansky": "B", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c19", "urn": "urn:cts:sanskritLit:mahabharata:16.5.2", "shloka_addr": "MBh. Mausala 16.5.2", "translator": "vassilkov", "raw_text": "Железный пест (мусала), рожденный Самбой. Символ саморазрушения рода. Васильков сравнивает с мифами о проклятых артефактах.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c20", "urn": "urn:cts:sanskritLit:mahabharata:18.5.10", "shloka_addr": "MBh. Svargārohaṇa 18.5.10", "translator": "vassilkov", "raw_text": "Финальный список заслуг (пхала-шрути). Чтение эпоса как очистительный акт. Васильков подчеркивает сакральный статус текста.", "has_iast": false, "axis_1_topic": ["realia", "context"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c21", "urn": "urn:cts:sanskritLit:mahabharata:3.5.1", "shloka_addr": "MBh. Vana 3.5.1", "translator": "vassilkov", "raw_text": "Образ Видуры как воплощения бога Дхармы. Васильков анализирует его статус «совести» Пандавов.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c22", "urn": "urn:cts:sanskritLit:mahabharata:3.10.12", "shloka_addr": "MBh. Vana 3.10.12", "translator": "vassilkov", "raw_text": "Описание леса Камьяка. Васильков идентифицирует географические ориентиры, сопоставляя их с современными топонимами.", "has_iast": false, "axis_1_topic": ["geography"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c23", "urn": "urn:cts:sanskritLit:mahabharata:8.30.5", "shloka_addr": "MBh. Karṇa 8.30.5", "translator": "vassilkov", "raw_text": "Инвективы Карны и Шальи. Васильков видит здесь отражение межплеменной вражды народов мадья и куру.", "has_iast": false, "axis_1_topic": ["realia", "context"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c24", "urn": "urn:cts:sanskritLit:mahabharata:10.5.15", "shloka_addr": "MBh. Sauptika 10.5.15", "translator": "vassilkov", "raw_text": "Молитва Ашваттхамана Шиве перед бойней. Васильков анализирует экстатический характер его преданности.", "has_iast": false, "axis_1_topic": ["myth", "philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c25", "urn": "urn:cts:sanskritLit:mahabharata:11.20.1", "shloka_addr": "MBh. Strī 11.20.1", "translator": "vassilkov", "raw_text": "Сцена «Сати» (самосожжения вдов). Васильков обсуждает историческую достоверность этого обычая в эпическую эпоху.", "has_iast": false, "axis_1_topic": ["realia"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c26", "urn": "urn:cts:sanskritLit:mahabharata:12.200.5", "shloka_addr": "MBh. Mokṣa 12.200.5", "translator": "vassilkov", "raw_text": "Понятие «пуруша» (дух) в противопоставлении «пракрити» (материи). Васильков отмечает дуализм раннего философского мышления.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K"},
  {"comment_id": "mbh/vassilkov/c27", "urn": "urn:cts:sanskritLit:mahabharata:14.50.1", "shloka_addr": "MBh. Aśvamedhika 14.50.1", "translator": "vassilkov", "raw_text": "История о мангусте с золотой головой. Васильков интерпретирует этот миф как критику пышных ритуалов в пользу искренней жертвы.", "has_iast": false, "axis_1_topic": ["myth", "philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c28", "urn": "urn:cts:sanskritLit:mahabharata:15.25.1", "shloka_addr": "MBh. Āśramavāsika 15.25.1", "translator": "vassilkov", "raw_text": "Видение мертвых воинов, выходящих из Ганги. Васильков сравнивает этот мотив с «дикой охотой» в европейском фольклоре.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c29", "urn": "urn:cts:sanskritLit:mahabharata:16.3.10", "shloka_addr": "MBh. Mausala 16.3.10", "translator": "vassilkov", "raw_text": "Разрушение Двараки волнами океана. Васильков сопоставляет миф с археологическими данными о затоплении древнего порта.", "has_iast": false, "axis_1_topic": ["geography", "realia"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c30", "urn": "urn:cts:sanskritLit:mahabharata:17.2.1", "shloka_addr": "MBh. Mahāprasthānika 17.2.1", "translator": "vassilkov", "raw_text": "Гибель Пандавов один за другим. Васильков видит в этом аллегорию кармического воздаяния за мелкие грехи.", "has_iast": false, "axis_1_topic": ["philosophy", "myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c31", "urn": "urn:cts:sanskritLit:mahabharata:3.50.2", "shloka_addr": "MBh. Vana 3.50.2", "translator": "vassilkov", "raw_text": "Роль Нарады как божественного вестника и провокатора. Васильков отмечает его связь с миром богов и людей.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c32", "urn": "urn:cts:sanskritLit:mahabharata:8.50.1", "shloka_addr": "MBh. Karṇa 8.50.1", "translator": "vassilkov", "raw_text": "Описание колесницы Карны. Васильков детально анализирует устройство боевых колесниц согласно «Артхашастре».", "has_iast": false, "axis_1_topic": ["realia"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c33", "urn": "urn:cts:sanskritLit:mahabharata:10.8.20", "shloka_addr": "MBh. Sauptika 10.8.20", "translator": "vassilkov", "raw_text": "Образ черной женщины (Каларатри), видимой воинам перед смертью. Васильков прослеживает иконографию богини смерти.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c34", "urn": "urn:cts:sanskritLit:mahabharata:11.25.1", "shloka_addr": "MBh. Strī 11.25.1", "translator": "vassilkov", "raw_text": "Прощание Дхритараштры с павшими сыновьями. Васильков отмечает психологическую глубину образа ослепленного царя.", "has_iast": false, "axis_1_topic": ["context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c35", "urn": "urn:cts:sanskritLit:mahabharata:12.250.1", "shloka_addr": "MBh. Mokṣa 12.250.1", "translator": "vassilkov", "raw_text": "Диалог Джаджили и Туладхары о природе ненасилия (ахимса). Васильков видит здесь влияние джайнских и буддийских идей.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "mbh/vassilkov/c36", "urn": "urn:cts:sanskritLit:mahabharata:14.70.1", "shloka_addr": "MBh. Aśvamedhika 14.70.1", "translator": "vassilkov", "raw_text": "Борьба Юдхиштхиры с собственными сомнениями. Васильков интерпретирует «Анугиту» как психотерапевтический текст.", "has_iast": false, "axis_1_topic": ["philosophy", "context"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "mbh/vassilkov/c37", "urn": "urn:cts:sanskritLit:mahabharata:15.30.5", "shloka_addr": "MBh. Āśramavāsika 15.30.5", "translator": "vassilkov", "raw_text": "Гибель Кунти, Гандхари и Дхритараштры в лесном пожаре. Васильков отмечает трагическую симметрию их конца.", "has_iast": false, "axis_1_topic": ["myth", "context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c38", "urn": "urn:cts:sanskritLit:mahabharata:16.8.1", "shloka_addr": "MBh. Mausala 16.8.1", "translator": "vassilkov", "raw_text": "Уход Арджуны, неспособного защитить женщин от разбойников. Васильков подчеркивает тему утраты героем его магической силы.", "has_iast": false, "axis_1_topic": ["myth", "context"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c39", "urn": "urn:cts:sanskritLit:mahabharata:17.3.1", "shloka_addr": "MBh. Mahāprasthānika 17.3.1", "translator": "vassilkov", "raw_text": "Отказ Юдхиштхиры войти в рай без собаки. Васильков видит в этом высшее проявление принципа ахимсы и верности.", "has_iast": false, "axis_1_topic": ["philosophy", "myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "mbh/vassilkov/c40", "urn": "urn:cts:sanskritLit:mahabharata:18.2.1", "shloka_addr": "MBh. Svargārohaṇa 18.2.1", "translator": "vassilkov", "raw_text": "Рай как место примирения врагов. Васильков отмечает парадоксальность эпического финала, где Дурьодхана оказывается на небесах.", "has_iast": false, "axis_1_topic": ["myth", "philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c41", "urn": "urn:cts:sanskritLit:mahabharata:3.100.1", "shloka_addr": "MBh. Vana 3.100.1", "translator": "vassilkov", "raw_text": "Сказание о Нале и Дамаянти. Васильков анализирует его как самостоятельную эпическую новеллу с фольклорными корнями.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c42", "urn": "urn:cts:sanskritLit:mahabharata:3.150.1", "shloka_addr": "MBh. Vana 3.150.1", "translator": "vassilkov", "raw_text": "Встреча Бхимы и Ханумана. Васильков отмечает встречу двух «сыновей ветра» как важный сюжетный узел.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c43", "urn": "urn:cts:sanskritLit:mahabharata:8.70.1", "shloka_addr": "MBh. Karṇa 8.70.1", "translator": "vassilkov", "raw_text": "Смерть Карны от стрелы Арджуны («анджалика»). Васильков детально описывает типы наконечников стрел в древней Индии.", "has_iast": false, "axis_1_topic": ["realia"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c44", "urn": "urn:cts:sanskritLit:mahabharata:10.15.1", "shloka_addr": "MBh. Sauptika 10.15.1", "translator": "vassilkov", "raw_text": "Участь Ашваттхамана — бессмертное скитание в ранах. Васильков сравнивает с легендой о Вечном Жиде.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c45", "urn": "urn:cts:sanskritLit:mahabharata:11.27.1", "shloka_addr": "MBh. Strī 11.27.1", "translator": "vassilkov", "raw_text": "Омовение в Ганге после битвы. Васильков отмечает ритуальный характер очищения от скверны смерти.", "has_iast": false, "axis_1_topic": ["realia"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c46", "urn": "urn:cts:sanskritLit:mahabharata:12.300.1", "shloka_addr": "MBh. Mokṣa 12.300.1", "translator": "vassilkov", "raw_text": "Учение Парашары о долге (дхарме) в разные юги. Васильков обсуждает концепцию «апад-дхармы» (закона для трудных времен).", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K"},
  {"comment_id": "mbh/vassilkov/c47", "urn": "urn:cts:sanskritLit:mahabharata:14.90.1", "shloka_addr": "MBh. Aśvamedhika 14.90.1", "translator": "vassilkov", "raw_text": "Возвращение Кришны в Двараку. Васильков отмечает ностальгический тон повествования перед финальной катастрофой.", "has_iast": false, "axis_1_topic": ["context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c48", "urn": "urn:cts:sanskritLit:mahabharata:15.35.1", "shloka_addr": "MBh. Āśramavāsika 15.35.1", "translator": "vassilkov", "raw_text": "Наставления Нарады Юдхиштхире о тщете земного величия. Васильков видит здесь проявление эпического пессимизма.", "has_iast": false, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D"},
  {"comment_id": "mbh/vassilkov/c49", "urn": "urn:cts:sanskritLit:mahabharata:16.9.1", "shloka_addr": "MBh. Mausala 16.9.1", "translator": "vassilkov", "raw_text": "Смерть Кришны от стрелы охотника Джары. Васильков сопоставляет с мифом об Ахилле и его уязвимой пятке.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"},
  {"comment_id": "mbh/vassilkov/c50", "urn": "urn:cts:sanskritLit:mahabharata:18.6.1", "shloka_addr": "MBh. Svargārohaṇa 18.6.1", "translator": "vassilkov", "raw_text": "Слияние героев со своими небесными прототипами (Пандавы — с богами, Кауравы — с асурами). Васильков отмечает окончание эпического цикла.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P"}
]
