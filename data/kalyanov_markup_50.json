[
  { "comment_id": "mbh/kalyanov/c1", "shloka_addr": "MBh. Ādi 1.1", "translator": "kalyanov", "raw_text": "Сута (sūta) — возница, представитель воинской касты. Воспевал подвиги повелителей.", "has_iast": true, "axis_1_topic": ["sanskrit_term"], "axis_2_kazansky": "A", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c2", "shloka_addr": "MBh. Ādi 1.15", "translator": "kalyanov", "raw_text": "Ганга (gaṅgā) — священная река индийцев. Согласно легендам, первоначально протекала на небесах.", "has_iast": true, "axis_1_topic": ["myth", "geography"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c3", "shloka_addr": "MBh. Ādi 1.20", "translator": "kalyanov", "raw_text": "Дхарма (dharma) — закон, долг, добродетель. Одно из четырех стремлений человека (puruṣārtha).", "has_iast": true, "axis_1_topic": ["philosophy", "sanskrit_term"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K" },
  { "comment_id": "mbh/kalyanov/c4", "shloka_addr": "MBh. Ādi 1.25", "translator": "kalyanov", "raw_text": "Брахман (brāhmaṇa) — представитель высшей, жреческой касты в древнеиндийском обществе.", "has_iast": true, "axis_1_topic": ["realia"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c5", "shloka_addr": "MBh. Ādi 1.30", "translator": "kalyanov", "raw_text": "Кшатрий (kṣatriya) — представитель воинской касты, правитель или воин.", "has_iast": true, "axis_1_topic": ["realia"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c6", "shloka_addr": "MBh. Sabhā 2.1", "translator": "kalyanov", "raw_text": "Майя (maya) — зодчий асуров, построивший великолепный дворец для Пандавов в Хастинапуре.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c7", "shloka_addr": "MBh. Sabhā 2.5", "translator": "kalyanov", "raw_text": "Раджасуя (rājasūya) — торжественное жертвоприношение, совершаемое царем при вступлении на престол.", "has_iast": true, "axis_1_topic": ["realia", "sanskrit_term"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c8", "shloka_addr": "MBh. Virāṭa 4.1", "translator": "kalyanov", "raw_text": "Аджнатаваса (ajñātavāsa) — «жизнь неузнанным»; период тайного изгнания Пандавов.", "has_iast": true, "axis_1_topic": ["sanskrit_term", "context"], "axis_2_kazansky": "A", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c9", "shloka_addr": "MBh. Udyoga 5.1", "translator": "kalyanov", "raw_text": "Вирата (virāṭa) — царь мацьев, тесть Абхиманью. Участвовал в битве на стороне Пандавов.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c10", "shloka_addr": "MBh. Droṇa 7.1", "translator": "kalyanov", "raw_text": "Дрона (droṇa) — наставник Пандавов и Кауравов в военном искусстве. Командовал армией Кауравов.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c11", "shloka_addr": "MBh. Ādi 2.1", "translator": "kalyanov", "raw_text": "Курукшетра (kurukṣetra) — поле Куру; место великой битвы между Пандавами и Кауравами.", "has_iast": true, "axis_1_topic": ["geography", "myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c12", "shloka_addr": "MBh. Ādi 3.5", "translator": "kalyanov", "raw_text": "Ашвамедха (aśvamedha) — жертвоприношение коня, подтверждающее верховную власть царя.", "has_iast": true, "axis_1_topic": ["realia", "sanskrit_term"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c13", "shloka_addr": "MBh. Ādi 4.10", "translator": "kalyanov", "raw_text": "Бхарата (bhārata) — потомок Бхараты; общее именование участников событий эпоса.", "has_iast": true, "axis_1_topic": ["sanskrit_term"], "axis_2_kazansky": "A", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c14", "shloka_addr": "MBh. Ādi 5.1", "translator": "kalyanov", "raw_text": "Аватара (avatāra) — нисхождение божества на землю в определенном облике.", "has_iast": true, "axis_1_topic": ["philosophy", "myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K" },
  { "comment_id": "mbh/kalyanov/c15", "shloka_addr": "MBh. Ādi 6.12", "translator": "kalyanov", "raw_text": "Яджна (yajña) — жертвоприношение, основной ритуал ведийской и эпической религии.", "has_iast": true, "axis_1_topic": ["realia", "sanskrit_term"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c16", "shloka_addr": "MBh. Ādi 7.3", "translator": "kalyanov", "raw_text": "Вайшья (vaiśya) — представитель третьей касты (земледельцы, ремесленники, торговцы).", "has_iast": true, "axis_1_topic": ["realia"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c17", "shloka_addr": "MBh. Ādi 8.2", "translator": "kalyanov", "raw_text": "Шудра (śūdra) — представитель низшей касты, слуга высших каст.", "has_iast": true, "axis_1_topic": ["realia"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c18", "shloka_addr": "MBh. Ādi 9.1", "translator": "kalyanov", "raw_text": "Агни (agni) — бог огня, посредник между людьми и богами при жертвоприношении.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c19", "shloka_addr": "MBh. Ādi 10.5", "translator": "kalyanov", "raw_text": "Индра (indra) — царь богов, бог грозы и битв.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c20", "shloka_addr": "MBh. Ādi 11.2", "translator": "kalyanov", "raw_text": "Сома (soma) — священный напиток и одноименное божество (также бог Луны).", "has_iast": true, "axis_1_topic": ["myth", "realia"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c21", "shloka_addr": "MBh. Ādi 12.1", "translator": "kalyanov", "raw_text": "Варуна (varuṇa) — бог океана, хранитель мирового порядка (рта).", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c22", "shloka_addr": "MBh. Ādi 13.5", "translator": "kalyanov", "raw_text": "Риши (ṛṣi) — мудрец, провидец, которому открыты божественные гимны.", "has_iast": true, "axis_1_topic": ["sanskrit_term", "myth"], "axis_2_kazansky": "A", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c23", "shloka_addr": "MBh. Ādi 14.1", "translator": "kalyanov", "raw_text": "Муни (muni) — отшельник, давший обет молчания; мудрец.", "has_iast": true, "axis_1_topic": ["sanskrit_term"], "axis_2_kazansky": "A", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c24", "shloka_addr": "MBh. Ādi 15.10", "translator": "kalyanov", "raw_text": "Тапас (tapas) — аскетическое подвижничество, порождающее магическую силу.", "has_iast": true, "axis_1_topic": ["philosophy", "realia"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K" },
  { "comment_id": "mbh/kalyanov/c25", "shloka_addr": "MBh. Ādi 16.3", "translator": "kalyanov", "raw_text": "Апсара (apsaras) — небесная нимфа, танцовщица при дворе Индры.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c26", "shloka_addr": "MBh. Ādi 17.5", "translator": "kalyanov", "raw_text": "Гандхарва (gandharva) — небесный певец и музыкант.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c27", "shloka_addr": "MBh. Ādi 18.1", "translator": "kalyanov", "raw_text": "Якша (yakṣa) — дух, хранитель сокровищ Куберы.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c28", "shloka_addr": "MBh. Ādi 19.4", "translator": "kalyanov", "raw_text": "Ракшас (rākṣasa) — злой демон, людоед, враждебный людям и богам.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c29", "shloka_addr": "MBh. Ādi 20.2", "translator": "kalyanov", "raw_text": "Асура (asura) — противник богов (суров), обитатель подземного мира.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c30", "shloka_addr": "MBh. Ādi 21.1", "translator": "kalyanov", "raw_text": "Дайтья (daitya) — потомок Дити; одно из именований асуров.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c31", "shloka_addr": "MBh. Ādi 22.3", "translator": "kalyanov", "raw_text": "Данава (dānava) — потомок Дану; другое именование асуров.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c32", "shloka_addr": "MBh. Ādi 23.5", "translator": "kalyanov", "raw_text": "Наг (nāga) — полубожественный змей, обитатель Паталы.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c33", "shloka_addr": "MBh. Ādi 24.1", "translator": "kalyanov", "raw_text": "Гаруда (garuḍa) — царь птиц, ездовое животное (вахана) бога Вишну.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c34", "shloka_addr": "MBh. Ādi 25.4", "translator": "kalyanov", "raw_text": "Вишну (viṣṇu) — один из главных богов индуизма, хранитель мироздания.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c35", "shloka_addr": "MBh. Ādi 26.2", "translator": "kalyanov", "raw_text": "Шива (śiva) — бог-разрушитель, один из тримурти.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c36", "shloka_addr": "MBh. Ādi 27.1", "translator": "kalyanov", "raw_text": "Брахма (brahmā) — бог-творец, первый в тримурти.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c37", "shloka_addr": "MBh. Ādi 28.3", "translator": "kalyanov", "raw_text": "Локапала (lokapāla) — хранитель сторон света.", "has_iast": true, "axis_1_topic": ["myth", "sanskrit_term"], "axis_2_kazansky": "A", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c38", "shloka_addr": "MBh. Ādi 29.5", "translator": "kalyanov", "raw_text": "Кубера (kubera) — бог богатства, владыка якшей.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c39", "shloka_addr": "MBh. Ādi 30.1", "translator": "kalyanov", "raw_text": "Яма (yama) — бог смерти и справедливости, владыка царства мертвых.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c40", "shloka_addr": "MBh. Ādi 31.4", "translator": "kalyanov", "raw_text": "Патала (pātāla) — подземный мир, обитель нагов и асуров.", "has_iast": true, "axis_1_topic": ["myth", "geography"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c41", "shloka_addr": "MBh. Ādi 32.2", "translator": "kalyanov", "raw_text": "Амрита (amṛta) — напиток бессмертия, добытый богами и асурами при пахтании океана.", "has_iast": true, "axis_1_topic": ["myth", "realia"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c42", "shloka_addr": "MBh. Ādi 33.1", "translator": "kalyanov", "raw_text": "Айравата (airāvata) — белый слон, ездовое животное Индры.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c43", "shloka_addr": "MBh. Ādi 34.5", "translator": "kalyanov", "raw_text": "Уччайхшравас (uccaiḥśravas) — небесный конь, добытый при пахтании океана.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/kalyanov/c44", "shloka_addr": "MBh. Ādi 35.2", "translator": "kalyanov", "raw_text": "Кальпа (kalpa) — огромный период времени, равный дню Брахмы.", "has_iast": true, "axis_1_topic": ["philosophy", "myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K" },
  { "comment_id": "mbh/kalyanov/c45", "shloka_addr": "MBh. Ādi 36.1", "translator": "kalyanov", "raw_text": "Юга (yuga) — мировой период в циклическом времени.", "has_iast": true, "axis_1_topic": ["philosophy", "myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K" },
  { "comment_id": "mbh/kalyanov/c46", "shloka_addr": "MBh. Ādi 37.3", "translator": "kalyanov", "raw_text": "Крита-юга (kṛtayuga) — первая и самая благая из четырех юг.", "has_iast": true, "axis_1_topic": ["philosophy", "myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K" },
  { "comment_id": "mbh/kalyanov/c47", "shloka_addr": "MBh. Ādi 38.5", "translator": "kalyanov", "raw_text": "Кали-юга (kaliyuga) — четвертая, нынешняя юга, эпоха упадка дхармы.", "has_iast": true, "axis_1_topic": ["philosophy", "myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K" },
  { "comment_id": "mbh/kalyanov/c48", "shloka_addr": "MBh. Ādi 39.2", "translator": "kalyanov", "raw_text": "Артха (artha) — польза, материальное благополучие; одна из целей человека.", "has_iast": true, "axis_1_topic": ["philosophy", "sanskrit_term"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K" },
  { "comment_id": "mbh/kalyanov/c49", "shloka_addr": "MBh. Ādi 40.1", "translator": "kalyanov", "raw_text": "Кама (kāma) — любовь, желание, чувственное удовольствие; одна из целей человека.", "has_iast": true, "axis_1_topic": ["philosophy", "sanskrit_term"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K" },
  { "comment_id": "mbh/kalyanov/c50", "shloka_addr": "MBh. Ādi 41.3", "translator": "kalyanov", "raw_text": "Мокша (mokṣa) — освобождение из цикла перерождений; высшая цель человека.", "has_iast": true, "axis_1_topic": ["philosophy", "sanskrit_term"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "D" }
]
