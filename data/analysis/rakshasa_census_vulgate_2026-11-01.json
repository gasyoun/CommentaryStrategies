 "southern_variant_tokens_sundara": {
  "variant_pairs_with_rākṣas": 122,
  "tokens": 126,
  "sample": [
   {
    "southern": "5.1.153",
    "tokens": 1,
    "text": "anyakāryaviṣaktasya baddhavairasya rākṣasaiḥ । tasya sītā hṛtā bhāryā rāvaṇena yaśasvinī ॥153॥"
   },
   {
    "southern": "5.2.15",
    "tokens": 1,
    "text": "sītāpaharaṇāt tena rāvaṇena surakṣitām । samantād vicaradbhiś ca rākṣasair ugradhanvibhiḥ ॥15॥"
   },
   {
    "southern": "5.2.20",
    "tokens": 1,
    "text": "pālitāṃ rākṣasendreṇa nirmitāṃ viśvakarmaṇā । plavamānām ivākāśe dadarśa hanumān kapiḥ ॥20॥"
   },
   {
    "southern": "5.2.25",
    "tokens": 1,
    "text": "daṃṣṭribhir bahubhiḥ śūraiḥ śūlapaṭṭiśapāṇibhiḥ । rakṣitāṃ rākṣasair ghorair guhām āśīviṣair iva ॥25॥"
   },
   {
    "southern": "5.2.29",
    "tokens": 1,
    "text": "avakāśo na sāmnastu rākṣaseṣv abhigamyate । na dānasya na bhedasya naiva yuddhasya dṛśyate ॥29॥"
   },
   {
    "southern": "5.2.34",
    "tokens": 1,
    "text": "mahaujaso mahāvīryo balavantaś ca rākṣasāḥ । vañcanīyā mayā sarve jānakīṃ parimārgitā ॥34॥"
   },
   {
    "southern": "5.2.44",
    "tokens": 1,
    "text": "vāyur apy atra nājñātaś cared iti matir mama । na hy atrāviditaṃ kiṃ cid rākṣasānāṃ bhīmakarmaṇām ॥44॥"
   },
   {
    "southern": "5.3.13",
    "tokens": 1,
    "text": "tāṃ samīkṣya purīṃ laṅkāṃ rākṣasādhipateḥ śubhām । anuttamām ṛddhimatīṃ cintayām āsa vīryavān ॥13॥"
   }
  ]
 },
 "hanuman_rakshasa_5_43_50": [
  {
   "verse_id": "5.46.2",
   "text": "स विरूपाक्षयूपाक्षौ दुर्धरं चैव राक्षसम्। ⏎ प्रघसं भासकर्णं च पञ्चसेनाग्रनायकान्।।5.46.2।। ⏎ सन्दिदेश दशग्रीवो वीरान्नयविशारदान्। ⏎ हनुमद्ग्रहणव्यग्रान्वायुवेगसमान्युधि।।5.46.3।।"
  },
  {
   "verse_id": "5.46.35",
   "text": "समुत्पाट्य गिरेश्शृङ्गं समृगव्यालपादपम्।।5.46.35।। ⏎ जघान हनुमान् वीरो राक्षसौ कपिकुञ्जरः।"
  },
  {
   "verse_id": "5.48.33",
   "text": "हनुमतो वेद न राक्षसोऽन्तरं न मारुतिस्तस्य महात्मनोऽन्तरम्। ⏎ परस्परं निर्विषहौ बभूवतुः समेत्य तौ देवसमानविक्रमौ।।5.48.33।।"
  },
  {
   "verse_id": "5.49.14",
   "text": "अपश्यद्राक्षसपतिं हनुमानतितेजसम्। ⏎ विष्ठितं मेरुशिखरे सतोयमिव तोयदम्।।5.49.14।।"
  },
  {
   "verse_id": "5.49.16",
   "text": "भ्राजमानं ततो दृष्ट्वा हनुमान्राक्षसेश्वरम्। ⏎ मनसा चिन्तयामास तेजसा तस्य मोहितः।।5.49.16।।"
  }
 ],
 "context_5_2_40_46": [
  {
   "verse_id": "5.2.40",
   "text": "अर्थानर्थान्तरे बुद्धिर्निश्चितापि न शोभते। ⏎ घातयन्ति हि कार्याणि दूताः पण्डितमानिनः।।5.2.40।।"
  },
  {
   "verse_id": "5.2.41",
   "text": "न  विनश्येत्कथं कार्यं वैक्लब्यं न कथं भवेत्। ⏎ लङ्घनं च समुद्रस्य कथं नु न वृथा भवेत्।।5.2.41।।"
  },
  {
   "verse_id": "5.2.42",
   "text": "मयि दृष्टे तु रक्षोभी रामस्य विदितात्मनः। ⏎ भवेद्व्यर्थमिदं कार्यं रावणानर्थमिच्छतः।।5.2.42।।"
  },
  {
   "verse_id": "5.2.43",
   "text": "न हि शक्यं क्वचित् स्थातुमविज्ञातेन राक्षसैः। ⏎ अपि राक्षसरूपेण किमुतान्येन केनचित्।।5.2.43।।"
  },
  {
   "verse_id": "5.2.44",
   "text": "वायुरप्यत्र नाज्ञातश्चरेदिति मतिर्मम। ⏎ न ह्य स्त्यविदितं किञ्चिद्राक्षसानां बलीयसाम्।।5.2.44।।"
  },
  {
   "verse_id": "5.2.45",
   "text": "इहाहं यदि तिष्ठामि स्वेन रूपेण संवृतः। ⏎ विनाशमुपयास्यामि भर्तुरर्थश्च हीयते।।5.2.45।।"
  },
  {
   "verse_id": "5.2.46",
   "text": "तदहं स्वेन रूपेण रजन्यां ह्रस्वतां गतः। ⏎ लङ्कामभिपतिष्यामि राघवस्यार्थसिद्धये।।5.2.46।।"
  }
 ],
