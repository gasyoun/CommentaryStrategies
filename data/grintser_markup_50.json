[
  { "comment_id": "ram/grintser/c1", "shloka_addr": "Rām. Bāla 1.1.1", "translator": "grintser", "raw_text": "«…Тёмнокожий (snigdha-varṇaḥ)…» Букв.: «цвета масла», «глянцевитый». Рама в иконографии изображается с тёмным телом.", "has_iast": true, "axis_1_topic": ["sanskrit_term"], "axis_2_kazansky": "A", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c2", "shloka_addr": "Rām. Bāla 1.1.1", "translator": "grintser", "raw_text": "Нарада (nārada) — божественный мудрец, посредник между богами и людьми, поэт (kavi). Первый, кто поведал Вальмики о деяниях Рамы.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c3", "shloka_addr": "Rām. Bāla 1.5.10", "translator": "grintser", "raw_text": "Айодхья (ayodhyā) — букв. «несокрушимая». Столица царства Кошала. Гринцер отмечает этимологическую значимость названия.", "has_iast": true, "axis_1_topic": ["geography", "sanskrit_term"], "axis_2_kazansky": "A", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c4", "shloka_addr": "Rām. Ayodhyā 2.1.1", "translator": "grintser", "raw_text": "Подготовка к посвящению Рамы в наследники (yuvarāja). Гринцер обсуждает юридические аспекты престолонаследия в древней Индии.", "has_iast": true, "axis_1_topic": ["realia"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c5", "shloka_addr": "Rām. Araṇya 3.1.1", "translator": "grintser", "raw_text": "Вступление в лес Дандака. Гринцер отмечает смену ландшафта и его символическое значение как места испытаний.", "has_iast": false, "axis_1_topic": ["geography", "context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c6", "shloka_addr": "Rām. Araṇya 3.15.5", "translator": "grintser", "raw_text": "Описание дерева Ашока (Saraca indica). Гринцер дает латинское название и отмечает роль дерева в любовной поэзии.", "has_iast": false, "axis_1_topic": ["realia"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c7", "shloka_addr": "Rām. Bāla 1.2.15", "translator": "grintser", "raw_text": "Проклятие Вальмики охотнику, убившему птицу крунча. Гринцер видит в этом рождение поэтического метра — шлоки.", "has_iast": false, "axis_1_topic": ["myth", "poetics"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D" },
  { "comment_id": "ram/grintser/c8", "shloka_addr": "Rām. Bāla 1.10.1", "translator": "grintser", "raw_text": "История Ришьяшринги. Гринцер сравнивает этот сюжет с легендами об отшельниках в других культурах.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c9", "shloka_addr": "Rām. Ayodhyā 2.10.5", "translator": "grintser", "raw_text": "Козни Кайкейи. Гринцер анализирует психологическую мотивировку её поступков через призму эпической драмы.", "has_iast": false, "axis_1_topic": ["context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c10", "shloka_addr": "Rām. Araṇya 3.45.10", "translator": "grintser", "raw_text": "Появление золотого оленя (Маричи). Гринцер отмечает фольклорный мотив оборотничества.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c11", "shloka_addr": "Rām. Bāla 1.30.5", "translator": "grintser", "raw_text": "«Тадака» (tāḍakā) — ракшаси, убитая Рамой. Гринцер обсуждает проблему убийства женщины героем.", "has_iast": true, "axis_1_topic": ["myth", "philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c12", "shloka_addr": "Rām. Bāla 1.67.1", "translator": "grintser", "raw_text": "Рама ломает лук Шивы. Гринцер сопоставляет это с испытанием жениха в «Одиссее».", "has_iast": false, "axis_1_topic": ["myth", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D" },
  { "comment_id": "ram/grintser/c13", "shloka_addr": "Rām. Ayodhyā 2.30.12", "translator": "grintser", "raw_text": "Речь Ситы о верности мужу. Гринцер отмечает идеализацию образа супруги в Рамаяне.", "has_iast": false, "axis_1_topic": ["context", "philosophy"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c14", "shloka_addr": "Rām. Araṇya 3.20.1", "translator": "grintser", "raw_text": "Схватка с Шурпанакхой. Гринцер обсуждает комические и гротескные элементы эпизода.", "has_iast": false, "axis_1_topic": ["poetics"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c15", "shloka_addr": "Rām. Araṇya 3.60.5", "translator": "grintser", "raw_text": "Горе Рамы после похищения Ситы. Гринцер отмечает зарождение стиля «кавья» (ученой поэзии) в описании природы.", "has_iast": false, "axis_1_topic": ["poetics"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D" },
  { "comment_id": "ram/grintser/c16", "shloka_addr": "Rām. Bāla 1.1.5", "translator": "grintser", "raw_text": "Эпитет «Вишвакарма» (всесоздатель). Гринцер поясняет его мифологический статус.", "has_iast": true, "axis_1_topic": ["myth", "sanskrit_term"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c17", "shloka_addr": "Rām. Bāla 1.45.1", "translator": "grintser", "raw_text": "Миф о пахтании океана. Гринцер отмечает его общеиндийский характер и значимость для обеих эпопей.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c18", "shloka_addr": "Rām. Ayodhyā 2.50.1", "translator": "grintser", "raw_text": "Переправа через Гангу. Гринцер обсуждает священный статус реки и ритуалы, связанные с переправой.", "has_iast": false, "axis_1_topic": ["realia", "geography"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c19", "shloka_addr": "Rām. Araṇya 3.5.1", "translator": "grintser", "raw_text": "Ашрам Шарабханги. Гринцер описывает быт лесных отшельников согласно тексту.", "has_iast": false, "axis_1_topic": ["realia"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c20", "shloka_addr": "Rām. Araṇya 3.70.1", "translator": "grintser", "raw_text": "Встреча с Шабари. Гринцер отмечает тему преданности (бхакти) со стороны представительницы низких племен.", "has_iast": false, "axis_1_topic": ["myth", "philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c21", "shloka_addr": "Rām. Bāla 1.4.1", "translator": "grintser", "raw_text": "Сыновья Рамы (Куша и Лава) поют Рамаяну. Гринцер отмечает самоотсылку текста и его устную природу.", "has_iast": false, "axis_1_topic": ["poetics", "context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c22", "shloka_addr": "Rām. Bāla 1.20.10", "translator": "grintser", "raw_text": "Описание оружия, полученного Рамой от Вишвамитры. Гринцер отмечает их персонифицированный характер.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c23", "shloka_addr": "Rām. Ayodhyā 2.20.1", "translator": "grintser", "raw_text": "Горе Дашаратхи. Гринцер анализирует концепцию «роковой ошибки» царя.", "has_iast": false, "axis_1_topic": ["context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c24", "shloka_addr": "Rām. Ayodhyā 2.80.1", "translator": "grintser", "raw_text": "Бхарата отправляется в лес на поиски Рамы. Гринцер отмечает благородство его характера.", "has_iast": false, "axis_1_topic": ["myth", "context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c25", "shloka_addr": "Rām. Araṇya 3.30.1", "translator": "grintser", "raw_text": "Битва Рамы с армией Кхары. Гринцер отмечает эпическую гиперболизацию силы героя.", "has_iast": false, "axis_1_topic": ["poetics"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c26", "shloka_addr": "Rām. Bāla 1.15.1", "translator": "grintser", "raw_text": "Жертвоприношение коня (ашвамедха) Дашаратхи. Гринцер поясняет его ритуальную структуру.", "has_iast": false, "axis_1_topic": ["realia"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c27", "shloka_addr": "Rām. Bāla 1.50.1", "translator": "grintser", "raw_text": "Миф об Ахалье. Гринцер анализирует тему очищения через проклятие.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c28", "shloka_addr": "Rām. Ayodhyā 2.40.1", "translator": "grintser", "raw_text": "Рама покидает Айодхью. Гринцер отмечает эмоциональный пик книги.", "has_iast": false, "axis_1_topic": ["context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c29", "shloka_addr": "Rām. Araṇya 3.10.1", "translator": "grintser", "raw_text": "Обещание Рамы мудрецам защитить их от ракшасов. Гринцер обсуждает долг кшатрия в лесу.", "has_iast": false, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c30", "shloka_addr": "Rām. Araṇya 3.50.1", "translator": "grintser", "raw_text": "Битва Джатаю с Раваной. Гринцер отмечает героическую жертву птицы.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c31", "shloka_addr": "Rām. Bāla 1.60.1", "translator": "grintser", "raw_text": "Миф о Тришанку. Гринцер обсуждает создание Вишвамитрой новой вселенной.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c32", "shloka_addr": "Rām. Ayodhyā 2.60.1", "translator": "grintser", "raw_text": "Смерть Дашаратхи. Гринцер отмечает связь между смертью царя и анархией в государстве.", "has_iast": false, "axis_1_topic": ["realia", "context"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c33", "shloka_addr": "Rām. Araṇya 3.55.1", "translator": "grintser", "raw_text": "Равана удерживает Ситу в роще Ашока. Гринцер описывает ландшафт Ланки.", "has_iast": false, "axis_1_topic": ["geography", "realia"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c34", "shloka_addr": "Rām. Bāla 1.75.1", "translator": "grintser", "raw_text": "Встреча Рамы с Парашурамой. Гринцер обсуждает смену аватаров Вишну.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D" },
  { "comment_id": "ram/grintser/c35", "shloka_addr": "Rām. Ayodhyā 2.90.1", "translator": "grintser", "raw_text": "Бхарата у Бхарадваджи. Гринцер отмечает гостеприимство мудреца и его магические силы.", "has_iast": false, "axis_1_topic": ["myth", "realia"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c36", "shloka_addr": "Rām. Araṇya 3.65.1", "translator": "grintser", "raw_text": "Встреча с Кабандхой. Гринцер анализирует образ безголового монстра.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c37", "shloka_addr": "Rām. Bāla 1.5.1", "translator": "grintser", "raw_text": "Описание богатств Айодхьи. Гринцер отмечает идеализацию городского устройства.", "has_iast": false, "axis_1_topic": ["geography", "realia"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c38", "shloka_addr": "Rām. Ayodhyā 2.100.1", "translator": "grintser", "raw_text": "Наставления Рамы Бхарате о правлении. Гринцер видит в этом трактат по политике (нити).", "has_iast": false, "axis_1_topic": ["philosophy", "realia"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c39", "shloka_addr": "Rām. Araṇya 3.40.1", "translator": "grintser", "raw_text": "Равана убеждает Маричу помочь ему. Гринцер отмечает фатализм Маричи.", "has_iast": false, "axis_1_topic": ["context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c40", "shloka_addr": "Rām. Bāla 1.35.1", "translator": "grintser", "raw_text": "История Ганги. Гринцер обсуждает её нисхождение на землю.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c41", "shloka_addr": "Rām. Ayodhyā 2.5.1", "translator": "grintser", "raw_text": "Подготовка Ситы к обряду посвящения Рамы. Гринцер отмечает её роль как верной супруги.", "has_iast": false, "axis_1_topic": ["realia", "context"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c42", "shloka_addr": "Rām. Araṇya 3.12.1", "translator": "grintser", "raw_text": "Встреча Рамы с Агастьей. Гринцер отмечает значимость мудреца для южной Индии.", "has_iast": false, "axis_1_topic": ["myth", "geography"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c43", "shloka_addr": "Rām. Bāla 1.70.1", "translator": "grintser", "raw_text": "Свадьба сыновей Дашаратхи. Гринцер описывает свадебные обряды древней Индии.", "has_iast": false, "axis_1_topic": ["realia"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c44", "shloka_addr": "Rām. Ayodhyā 2.115.1", "translator": "grintser", "raw_text": "Бхарата правит от имени сандалий Рамы. Гринцер отмечает этот символ как высшую степень преданности.", "has_iast": false, "axis_1_topic": ["myth", "realia"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c45", "shloka_addr": "Rām. Araṇya 3.75.1", "translator": "grintser", "raw_text": "Рама на берегу озера Пампа. Гринцер отмечает поэтическое предчувствие встречи с Хануманом.", "has_iast": false, "axis_1_topic": ["poetics", "context"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c46", "shloka_addr": "Rām. Bāla 1.25.1", "translator": "grintser", "raw_text": "Миф о рождении Картикеи (Сканды). Гринцер отмечает его связь с армией богов.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c47", "shloka_addr": "Rām. Ayodhyā 2.15.1", "translator": "grintser", "raw_text": "Санджая возвещает о готовности к помазанию. Гринцер отмечает трагический диссонанс с планами Кайкейи.", "has_iast": false, "axis_1_topic": ["context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c48", "shloka_addr": "Rām. Araṇya 3.25.1", "translator": "grintser", "raw_text": "Кхара и Душана готовятся к нападению. Гринцер описывает облик армии ракшасов.", "has_iast": false, "axis_1_topic": ["myth", "realia"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c49", "shloka_addr": "Rām. Bāla 1.80.1", "translator": "grintser", "raw_text": "Возвращение Рамы в Айодхью после свадьбы. Гринцер отмечает завершение первой книги.", "has_iast": false, "axis_1_topic": ["context"], "axis_2_kazansky": "V", "axis_3_lakshana": [], "axis_4_paribok": "P" },
  { "comment_id": "ram/grintser/c50", "shloka_addr": "Rām. Araṇya 3.68.1", "translator": "grintser", "raw_text": "Освобождение Кабандхи от проклятия. Гринцер отмечает мотив спасения через смерть от руки героя.", "has_iast": false, "axis_1_topic": ["myth", "philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" }
]
