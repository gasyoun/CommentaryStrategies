[
  { "comment_id": "mbh/erman/c1", "shloka_addr": "MBh. Bhīṣma 6.1.3", "translator": "erman", "raw_text": "«…искушённые в чтении Вед…» Подразумевается ритуальное чтение священных текстов (adhyāyana), которому приписывается магическое действие.", "has_iast": true, "axis_1_topic": ["realia", "sanskrit_term"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c2", "shloka_addr": "MBh. Bhīṣma 6.1.9", "translator": "erman", "raw_text": "«Йоджана…» Мера длины, определяемая обычно как равная 13–14 км. См. Бхагавадгита 1999: 231.", "has_iast": false, "axis_1_topic": ["realia", "reference"], "axis_2_kazansky": "B", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c3", "shloka_addr": "MBh. Bhīṣma 6.1.10", "translator": "erman", "raw_text": "«Белая (śveta) планета». Так именуется в лексиконах Шукра (Венера), но здесь, возможно, имеется в виду Кету. См. Индуизм 1996: 230–231.", "has_iast": true, "axis_1_topic": ["myth", "reference"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2", "L5"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c4", "shloka_addr": "MBh. Gītā 6.25.1", "translator": "erman", "raw_text": "Первая шлока Бхагавадгиты. Поле дхармы (dharmakṣetra) — Курукшетра. Эрман отмечает двойной смысл: место битвы и место духовного подвига.", "has_iast": true, "axis_1_topic": ["philosophy", "context"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D" },
  { "comment_id": "mbh/erman/c5", "shloka_addr": "MBh. Gītā 6.26.7", "translator": "erman", "raw_text": "«Йога» (yoga) — в данном контексте понимается как дисциплина ума и искусство действия. Девабодха поясняет это как «сосредоточенность» (samādhi).", "has_iast": true, "axis_1_topic": ["philosophy", "sanskrit_term"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2", "L5"], "axis_4_paribok": "K" },
  { "comment_id": "mbh/erman/c6", "shloka_addr": "MBh. Gītā 6.27.10", "translator": "erman", "raw_text": "Понятие «Санкхья» (sāṃkhya) — философское учение о различении духа и материи. Эрман обсуждает соотношение санкхьи и йоги в тексте Гиты.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D" },
  { "comment_id": "mbh/erman/c7", "shloka_addr": "MBh. Bhīṣma 6.45.1", "translator": "erman", "raw_text": "Описание построения войск «Вьюха» (vyūha). Эрман ссылается на военные трактаты древней Индии.", "has_iast": true, "axis_1_topic": ["realia", "reference"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c8", "shloka_addr": "MBh. Bhīṣma 6.100.10", "translator": "erman", "raw_text": "Падение Бхишмы на ложе из стрел. Эрман отмечает поэтическую силу образа и его символическое значение как конца эпохи.", "has_iast": false, "axis_1_topic": ["myth", "context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c9", "shloka_addr": "MBh. Gītā 6.32.1", "translator": "erman", "raw_text": "Кришна являет Вселенскую форму (viśvarūpa). Эрман анализирует иконографические детали описания. См. Вишну 1990: 45.", "has_iast": true, "axis_1_topic": ["myth", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D" },
  { "comment_id": "mbh/erman/c10", "shloka_addr": "MBh. Gītā 6.40.1", "translator": "erman", "raw_text": "Понятие «Бхакти» (bhakti) — преданность, любовь к богу. Эрман прослеживает развитие этого термина в эпическую эпоху.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "D" },
  { "comment_id": "mbh/erman/c11", "shloka_addr": "MBh. Bhīṣma 6.2.1", "translator": "erman", "raw_text": "Зловещие знамения перед битвой. Эрман сравнивает с аналогичными описаниями в греческом эпосе. См. Гомер 1967: 112.", "has_iast": false, "axis_1_topic": ["myth", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c12", "shloka_addr": "MBh. Bhīṣma 6.5.15", "translator": "erman", "raw_text": "География Джамбудвипы. Эрман обсуждает космологические представления древних индийцев.", "has_iast": true, "axis_1_topic": ["geography", "myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c13", "shloka_addr": "MBh. Gītā 6.28.5", "translator": "erman", "raw_text": "«Нишкама-карма» — действие без привязанности к результату. Ключевое этическое учение Гиты в интерпретации Эрмана.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D" },
  { "comment_id": "mbh/erman/c14", "shloka_addr": "MBh. Gītā 6.30.12", "translator": "erman", "raw_text": "Понятие «Кшетра» (поле) и «Кшетраджня» (знаток поля). Эрман поясняет как метафору тела и души.", "has_iast": true, "axis_1_topic": ["philosophy", "sanskrit_term"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K" },
  { "comment_id": "mbh/erman/c15", "shloka_addr": "MBh. Bhīṣma 6.110.1", "translator": "erman", "raw_text": "Уход Бхишмы (иччха-мритью) — способность выбрать момент смерти. Эрман отмечает его исключительный статус как аскета-воина.", "has_iast": true, "axis_1_topic": ["myth", "realia"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c16", "shloka_addr": "MBh. Bhīṣma 6.15.3", "translator": "erman", "raw_text": "Символика знамен героев. Эрман идентифицирует изображения на штандартах согласно «Нилакантхе».", "has_iast": false, "axis_1_topic": ["myth", "reference"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2", "L5"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c17", "shloka_addr": "MBh. Gītā 6.35.1", "translator": "erman", "raw_text": "Учение о трех путях (марга): знание, действие, преданность. Эрман обсуждает их синтез в Гите.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D" },
  { "comment_id": "mbh/erman/c18", "shloka_addr": "MBh. Gītā 6.38.10", "translator": "erman", "raw_text": "«Брахман» (абсолют) — Эрман поясняет различие между персонифицированным и безличным аспектом божества.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "D" },
  { "comment_id": "mbh/erman/c19", "shloka_addr": "MBh. Bhīṣma 6.8.2", "translator": "erman", "raw_text": "Мера времени «Мухурта». Эрман дает точное определение согласно астрономическим трактатам.", "has_iast": true, "axis_1_topic": ["realia"], "axis_2_kazansky": "B", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c20", "shloka_addr": "MBh. Bhīṣma 6.120.5", "translator": "erman", "raw_text": "Финальная сцена Бхишма-парвы. Эрман подводит итог первой фазе великой войны.", "has_iast": false, "axis_1_topic": ["context"], "axis_2_kazansky": "V", "axis_3_lakshana": [], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c21", "shloka_addr": "MBh. Bhīṣma 6.4.1", "translator": "erman", "raw_text": "Генеалогия династии Куру. Эрман проясняет запутанные родственные связи героев.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c22", "shloka_addr": "MBh. Gītā 6.25.20", "translator": "erman", "raw_text": "Образ Арджуны, бросающего лук Гандиву. Эрман анализирует его экзистенциальный кризис (вишада).", "has_iast": true, "axis_1_topic": ["philosophy", "context"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D" },
  { "comment_id": "mbh/erman/c23", "shloka_addr": "MBh. Gītā 6.26.1", "translator": "erman", "raw_text": "Ответ Кришны Арджуне. Эрман отмечает смену тона повествования с эпического на дидактический.", "has_iast": false, "axis_1_topic": ["context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c24", "shloka_addr": "MBh. Gītā 6.27.15", "translator": "erman", "raw_text": "Понятие «Атман» (душа). Эрман обсуждает его бессмертную природу согласно Гите.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "D" },
  { "comment_id": "mbh/erman/c25", "shloka_addr": "MBh. Bhīṣma 6.50.2", "translator": "erman", "raw_text": "Описание битвы Гхатоткачи. Эрман отмечает элементы магического сражения (майя).", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c26", "shloka_addr": "MBh. Bhīṣma 6.60.1", "translator": "erman", "raw_text": "Роль Саиндхавы (Джаядратхи) в задержке Пандавов. Эрман поясняет его предысторию.", "has_iast": false, "axis_1_topic": ["myth", "context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c27", "shloka_addr": "MBh. Gītā 6.33.1", "translator": "erman", "raw_text": "«Кало 'сми» — Я есть Время. Эрман анализирует эсхатологический аспект божества. См. Кала 1985: 67.", "has_iast": true, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D" },
  { "comment_id": "mbh/erman/c28", "shloka_addr": "MBh. Gītā 6.34.5", "translator": "erman", "raw_text": "Понятие «Пракрити» (природа). Эрман обсуждает ее восемь аспектов согласно тексту.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K" },
  { "comment_id": "mbh/erman/c29", "shloka_addr": "MBh. Bhīṣma 6.12.3", "translator": "erman", "raw_text": "Упоминание «Млеччхов» (чужеземцев). Эрман обсуждает этнический состав армий в Махабхарате.", "has_iast": true, "axis_1_topic": ["realia"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c30", "shloka_addr": "MBh. Bhīṣma 6.20.1", "translator": "erman", "raw_text": "Речь Юдхиштхиры перед началом боя. Эрман отмечает его приверженность принципу ненасилия даже в войне.", "has_iast": false, "axis_1_topic": ["philosophy", "context"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D" },
  { "comment_id": "mbh/erman/c31", "shloka_addr": "MBh. Gītā 6.31.2", "translator": "erman", "raw_text": "Символика лотоса в Гите. Эрман поясняет метафору незагрязненности миром.", "has_iast": false, "axis_1_topic": ["philosophy", "poetics"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c32", "shloka_addr": "MBh. Gītā 6.36.1", "translator": "erman", "raw_text": "Понятие «Майя» как божественная энергия сокрытия истины. Эрман прослеживает развитие термина.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "D" },
  { "comment_id": "mbh/erman/c33", "shloka_addr": "MBh. Bhīṣma 6.80.1", "translator": "erman", "raw_text": "Подвиги Швета в первый день битвы. Эрман отмечает архаичные черты его образа.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c34", "shloka_addr": "MBh. Bhīṣma 6.90.1", "translator": "erman", "raw_text": "Гибель Иравана, сына Арджуны. Эрман обсуждает культ Иравана в южной Индии.", "has_iast": false, "axis_1_topic": ["myth", "realia"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c35", "shloka_addr": "MBh. Gītā 6.39.1", "translator": "erman", "raw_text": "«Кшара» и «Акшара» — преходящее и вечное. Эрман поясняет онтологические категории Гиты.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K" },
  { "comment_id": "mbh/erman/c36", "shloka_addr": "MBh. Gītā 6.42.1", "translator": "erman", "raw_text": "Финальные наставления Кришны о предании себя (шаранагати). Эрман видит в этом вершину бхакти.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D" },
  { "comment_id": "mbh/erman/c37", "shloka_addr": "MBh. Bhīṣma 6.3.10", "translator": "erman", "raw_text": "Образ Гхатоткачи как типичного ракшаса. Эрман отмечает его преданность Пандавам.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c38", "shloka_addr": "MBh. Bhīṣma 6.10.1", "translator": "erman", "raw_text": "Список рек и народов Бхаратаварши. Эрман сопоставляет с историческими данными. См. Бхарата 1992: 156.", "has_iast": false, "axis_1_topic": ["geography", "reference"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c39", "shloka_addr": "MBh. Gītā 6.29.1", "translator": "erman", "raw_text": "Понятие «Виджняна» — практическое знание в отличие от теоретического (Джняна).", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K" },
  { "comment_id": "mbh/erman/c40", "shloka_addr": "MBh. Gītā 6.37.1", "translator": "erman", "raw_text": "Понятие «Пурушоттама» — высший дух. Эрман обсуждает уникальность этого термина для Гиты.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "D" },
  { "comment_id": "mbh/erman/c41", "shloka_addr": "MBh. Bhīṣma 6.1.1", "translator": "erman", "raw_text": "Вопрос Дхритараштры Санджае. Эрман отмечает роль Санджаи как божественного репортера с «дибья-чакшу» (небесным зрением).", "has_iast": true, "axis_1_topic": ["myth", "context"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c42", "shloka_addr": "MBh. Bhīṣma 6.7.1", "translator": "erman", "raw_text": "Описание гор Меру и Химават. Эрман обсуждает мифическую географию как отражение духовных уровней.", "has_iast": false, "axis_1_topic": ["myth", "geography"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c43", "shloka_addr": "MBh. Gītā 6.26.20", "translator": "erman", "raw_text": "Состояние «стхита-праджня» — человека с утвердившимся разумом. Эрман детально разбирает качества такого мудреца.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "D" },
  { "comment_id": "mbh/erman/c44", "shloka_addr": "MBh. Gītā 6.27.5", "translator": "erman", "raw_text": "Понятие «Брахма-нирвана» — угасание в Брахмане. Эрман обсуждает буддийские параллели термина.", "has_iast": true, "axis_1_topic": ["philosophy", "reference"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2", "L5"], "axis_4_paribok": "D" },
  { "comment_id": "mbh/erman/c45", "shloka_addr": "MBh. Bhīṣma 6.115.10", "translator": "erman", "raw_text": "Сцена, где Арджуна выбивает стрелой воду из земли для Бхишмы. Эрман отмечает магический аспект мастерства.", "has_iast": false, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c46", "shloka_addr": "MBh. Bhīṣma 6.13.1", "translator": "erman", "raw_text": "Описание оружия Карны — «Шакти». Эрман поясняет его происхождение от Индры.", "has_iast": true, "axis_1_topic": ["myth"], "axis_2_kazansky": "V", "axis_3_lakshana": ["L2"], "axis_4_paribok": "P" },
  { "comment_id": "mbh/erman/c47", "shloka_addr": "MBh. Gītā 6.30.5", "translator": "erman", "raw_text": "Понятие «Адхибхута», «Адхидайва», «Адхияджна». Эрман поясняет иерархию уровней реальности.", "has_iast": true, "axis_1_topic": ["philosophy"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L2"], "axis_4_paribok": "K" },
  { "comment_id": "mbh/erman/c48", "shloka_addr": "MBh. Gītā 6.31.10", "translator": "erman", "raw_text": "Образ бога как «нити, на которую нанизаны жемчужины». Эрман отмечает поэтическую точность метафоры.", "has_iast": false, "axis_1_topic": ["philosophy", "poetics"], "axis_2_kazansky": "G", "axis_3_lakshana": ["L5"], "axis_4_paribok": "P" },
